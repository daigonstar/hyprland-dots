 /* wallust template - colors-rofi */

* {
active-background: #B8C5D1;
active-foreground: #EAEEF2;
normal-background: #000006;
normal-foreground: #EAEEF2;
urgent-background: #F2BCC3;
urgent-foreground: #EAEEF2;

alternate-active-background: #778594;
alternate-active-foreground: #EAEEF2;
alternate-normal-background: #000006;
alternate-normal-foreground: #EAEEF2;
alternate-urgent-background: #000006;
alternate-urgent-foreground: #EAEEF2;

selected-active-background: #F2BCC3;
selected-active-foreground: #EAEEF2;
selected-normal-background: #F2BCC3;
selected-normal-foreground: #EAEEF2;
selected-urgent-background: #B8C5D1;
selected-urgent-foreground: #EAEEF2;

background-color: #000006;
background: rgba(0,0,0,0.7);
foreground: #EAEEF2;
border-color: #B8C5D1;

color0: #01040A;
color1: #56606B;
color2: #56606B;
color3: #59646F;
color4: #8A949C;
color5: #B58D92;
color6: #929BA4;
color7: #D8DFE4;
color8: #979CA0;
color9: #72808F;
color10: #72808F;
color11: #778594;
color12: #B8C5D1;
color13: #F2BCC3;
color14: #C2CFDA;
color15: #D8DFE4;


}

