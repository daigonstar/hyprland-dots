 /* wallust template - colors-rofi */

* {
active-background: #624D06;
active-foreground: #C1D2B0;
normal-background: #000300;
normal-foreground: #C1D2B0;
urgent-background: #537116;
urgent-foreground: #C1D2B0;

alternate-active-background: #971759;
alternate-active-foreground: #C1D2B0;
