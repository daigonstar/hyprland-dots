 /* wallust template - colors-rofi */

* {
active-background: #8D949C;
active-foreground: #F5F7F9;
normal-background: #000004;
normal-foreground: #F5F7F9;
urgent-background: #D8DEE3;
urgent-foreground: #F5F7F9;

alternate-active-background: #BE8353;
alternate-active-foreground: #F5F7F9;
alternate-normal-background: #000004;
alternate-normal-foreground: #F5F7F9;
alternate-urgent-background: #000004;
alternate-urgent-foreground: #F5F7F9;

selected-active-background: #D8DEE3;
selected-active-foreground: #F5F7F9;
selected-normal-background: #D8DEE3;
selected-normal-foreground: #F5F7F9;
selected-urgent-background: #8D949C;
