alternate-normal-foreground: #C1D2B0;
alternate-urgent-background: #000300;
alternate-urgent-foreground: #C1D2B0;

selected-active-background: #537116;
selected-active-foreground: #C1D2B0;
selected-normal-background: #537116;
selected-normal-foreground: #C1D2B0;
