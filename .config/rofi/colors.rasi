 /* wallust template - colors-rofi */

* {
active-background: #C67E53;
active-foreground: #FCF5E7;
normal-background: #010100;
normal-foreground: #FCF5E7;
urgent-background: #CE8558;
urgent-foreground: #FCF5E7;

alternate-active-background: #8F5136;
alternate-active-foreground: #FCF5E7;
alternate-normal-background: #010100;
alternate-normal-foreground: #FCF5E7;
alternate-urgent-background: #010100;
alternate-urgent-foreground: #FCF5E7;

selected-active-background: #CE8558;
selected-active-foreground: #FCF5E7;
selected-normal-background: #CE8558;
selected-normal-foreground: #FCF5E7;
selected-urgent-background: #C67E53;
selected-urgent-foreground: #FCF5E7;

background-color: #010100;
background: rgba(0,0,0,0.7);
foreground: #FCF5E7;
border-color: #C67E53;

color0: #010100;
color1: #343718;
color2: #683B27;
color3: #6B3D29;
color4: #945F3F;
color5: #9B6442;
color6: #B8AA8C;
color7: #F2E8D4;
color8: #A9A295;
color9: #454920;
color10: #8B4E34;
color11: #8F5136;
color12: #C67E53;
