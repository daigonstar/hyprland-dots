## Hyprland Config ##

############################################
### Monitors (generated by NWG-Displays) ###
############################################
source= ~/.config/hypr/monitors.conf 

##############################
### Workspaces             ###
##############################

source= ~/.config/hypr/workspaces.conf

##############################
### My Programs & Keybinds ###
##############################
source= ~/.config/hypr/keybinds.conf

#############
### INPUT ###
#############
source= ~/.config/hypr/userconf.conf

#################
### AUTOSTART ###
#################
source= ~/.config/hypr/autostart.conf

#############################
### ENVIRONMENT VARIABLES ###
#############################
source= ~/.config/hypr/hyprenv.conf

##############################
### WINDOWS AND WORKSPACES ###
##############################
source= ~/.config/hypr/window.conf



monitor=DP-1,2560x1440@164.84,0x0,1.00
monitor=DP-2,1920x1080@60.00,2560x160,1.00