 /* wallust template - colors-rofi */

* {
active-background: #DB3753;
active-foreground: #F0E6B6;
normal-background: #1F1F26;
normal-foreground: #F0E6B6;
urgent-background: #C7AE2F;
urgent-foreground: #F0E6B6;

alternate-active-background: #817435;
alternate-active-foreground: #F0E6B6;
alternate-normal-background: #1F1F26;
alternate-normal-foreground: #F0E6B6;
alternate-urgent-background: #1F1F26;
alternate-urgent-foreground: #F0E6B6;

selected-active-background: #C7AE2F;
selected-active-foreground: #F0E6B6;
selected-normal-background: #C7AE2F;
selected-normal-foreground: #F0E6B6;
selected-urgent-background: #DB3753;
selected-urgent-foreground: #F0E6B6;

background-color: #1F1F26;
background: rgba(0,0,0,0.7);
foreground: #F0E6B6;
border-color: #DB3753;

color0: #46454D;
color1: #35332B;
color2: #4D4023;
color3: #615728;
color4: #A4293E;
color5: #958323;
color6: #9E8A22;
color7: #E0D38E;
