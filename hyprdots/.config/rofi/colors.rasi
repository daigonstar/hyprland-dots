 /* wallust template - colors-rofi */

* {
active-background: #CE9F63;
active-foreground: #F1F5F6;
normal-background: #040002;
normal-foreground: #F1F5F6;
urgent-background: #CDD8DA;
urgent-foreground: #F1F5F6;

alternate-active-background: #908E95;
alternate-active-foreground: #F1F5F6;
alternate-normal-background: #040002;
alternate-normal-foreground: #F1F5F6;
alternate-urgent-background: #040002;
alternate-urgent-foreground: #F1F5F6;

